# ─────────────────────────────────────────────
# PrepQ Environment Variables
# Copy this file to .env and fill in all values.
# NEVER commit .env to version control.
# ─────────────────────────────────────────────

# ── AI ──────────────────────────────────────
# Groq API key (console.groq.com)
GROQ_API_KEY=

# ── Database & Auth ─────────────────────────
# Supabase project URL (Settings → API → Project URL)
SUPABASE_URL=

# Supabase service role key — has full DB access, keep secret
# (Settings → API → service_role secret)
SUPABASE_SERVICE_KEY=

# JWT secret — must match your Supabase JWT secret
# (Settings → API → JWT Secret)
JWT_SECRET=

# ── Cache & Rate Limiting ───────────────────
# Upstash Redis REST URL (console.upstash.com → Redis → REST URL)
UPSTASH_REDIS_URL=

# Upstash Redis REST token
UPSTASH_REDIS_TOKEN=

# ── Application ─────────────────────────────
# Frontend URL for CORS (no trailing slash)
FRONTEND_URL=http://localhost:3000

# Environment: development | production
ENVIRONMENT=development

# Backend port
PORT=8000
