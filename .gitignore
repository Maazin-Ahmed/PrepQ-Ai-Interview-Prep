# ─────────────────────────────────────────────
# PrepQ — .gitignore
# ─────────────────────────────────────────────

# ── Secrets — NEVER commit these ────────────
.env
.env.local
.env.*.local
*.pem
*.key

# ── Python ───────────────────────────────────
__pycache__/
*.py[cod]
*.pyo
*.pyd
.Python
venv/
.venv/
env/
*.egg-info/
dist/
build/
.pytest_cache/
.mypy_cache/
.ruff_cache/
htmlcov/
.coverage

# ── Node / Next.js ───────────────────────────
node_modules/
.next/
out/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnp/
.pnp.js

# ── OS ───────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini

# ── Editor ───────────────────────────────────
.vscode/settings.json
.idea/
*.swp
*.swo

# ── Docker ───────────────────────────────────
docker-compose.override.yml

# ── Logs ─────────────────────────────────────
*.log
logs/
